{
  "exclusive": true,
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 32,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap",
    "wlr/taskbar",
    "mpris",
    "custom/cat"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "hyprland/language",
    "custom/weather",
    "network",
    "pulseaudio",
    "battery",
    "tray",
    "clock"
  ],
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },
  "hyprland/window": {
    "max-length": 72
  },
  "hyprland/language": {
    "format": "  {long}",
    "tooltip": false
  },
  "clock": {
    "format": "  {:%H:%M:%S  %d %b}",
    "tooltip-format": "<span>{calendar}</span>",
    "interval": 1,
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  },
  "network": {
    "format": "leaked IP: {ipaddr}",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "nospacing": 0,
    "on-click": "ghostty -e impala"
  },
  "custom/cat": {
    "exec": "~/.dotfiles/.config/waybar/cats.sh",
    "interval": 5,
    "tooltip": false,
    "format": "{}"
  },
  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "interval": 1800,
    "exec": "wttrbar --location Vienna -l de --custom-indicator '{ICON} {temp_C}° ({FeelsLikeC}°)'",
    "return-type": "json"
  },
  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "󰝟 Muted",
    "on-click": "ghostty -e wiremix -v output"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{capacity}% {icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{timeTo}",
    "tooltip-format-charging": "{timeTo}",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "<span>{status_icon} {dynamic}</span>",
    "max-length": 30,
    "interval": 1,
    "player-icons": {
      "default": "🎵"
    },
    "status-icons": {
      "paused": "▶"
    },
    "ignored-players": [
      "firefox",
      "zen-browser",
      "chromium",
      "brave"
    ]
  },
  "tray": {
    "icon-size": 12,
    "spacing": 10
  }
}